FROM node:22-bookworm-slim AS build
WORKDIR /app

ARG VITE_API_BASE_URL
ARG VITE_ENABLE_PAYMENT_MOCK=false
ARG VITE_MERCADO_PAGO_PUBLIC_KEY=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_ENABLE_PAYMENT_MOCK=$VITE_ENABLE_PAYMENT_MOCK \
    VITE_MERCADO_PAGO_PUBLIC_KEY=$VITE_MERCADO_PAGO_PUBLIC_KEY

COPY package.json package-lock.json ./
COPY backend-api/package.json backend-api/package.json
COPY frontend/package.json frontend/package.json
COPY backend-api-e2e/package.json backend-api-e2e/package.json
COPY packages/ packages/
RUN npm ci --legacy-peer-deps

COPY . .
RUN npx nx build frontend --configuration=production

FROM nginxinc/nginx-unprivileged:stable-alpine AS runtime
COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
